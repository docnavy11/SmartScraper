# Copy to .env. Everything here has a working default except the API key.
# Anything not set falls back to the value in smartscraper/config.py, and most
# settings are editable in the UI at runtime, which overrides both.

# --- the only one you must set ---
# Not needed if the Claude Agent SDK finds credentials of its own, which it does
# when the Claude Code CLI is already signed in on this machine.
# SS_ANTHROPIC_API_KEY=sk-ant-...

# --- where it listens ---
# Loopback by default. Binding anywhere else needs SS_WEB_PASSWORD, and the MCP
# endpoint needs SS_MCP_BEARER_TOKEN, or startup refuses and says why.
# SS_HOST=127.0.0.1
# SS_PORT=8088
# SS_WEB_USER=admin
# SS_WEB_PASSWORD=
# SS_MCP_BEARER_TOKEN=

# Only sensible behind a proxy that authenticates for you.
# SS_ALLOW_INSECURE_BIND=0

# --- models and spend ---
# SS_BUILDER_MODEL=claude-opus-5
# SS_REPAIR_MODEL=claude-opus-5
# SS_FALLBACK_MODEL=claude-sonnet-5
# SS_MONTHLY_BUDGET=60.0
# SS_DEFAULT_SCRAPER_BUDGET=10.0

# --- browsers ---
# Headed is less detectable, and turns itself off when there is no display.
# SS_HEADED=true
# SS_RESPECT_ROBOTS=true

# --- secrets at rest ---
# Fernet key for encrypted columns. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SS_SECRET_KEY=
